# Runtime mode: development, test, or production. Defaults to development.
NODE_ENV=

# Required: MongoDB Atlas or replica-set/sharded-cluster connection URI.
MONGO_URI=
# Optional MongoDB driver/startup controls with production-safe defaults.
MONGO_SERVER_SELECTION_TIMEOUT_MS=
MONGO_MAX_POOL_SIZE=
MONGO_RETRY_ATTEMPTS=
MONGO_RETRY_DELAY_MS=
# Required: a randomly generated signing secret of at least 32 characters.
JWT_SECRET=

# CLI-only platform bootstrap; never retained in production runtime configuration.
# No defaults; password must be 12+ characters, <=72 UTF-8 bytes, with
# uppercase/lowercase letters, a digit, and a non-whitespace special character.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=
PLATFORM_ADMIN_BOOTSTRAP_FULL_NAME=
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=

# Required: frontend/application URL that consumes activation links.
# Its origin also hosts /admin for platform password recovery links.
ACCOUNT_ACTIVATION_URL=
# Required: frontend/application URL that consumes employee invitation links.
EMPLOYEE_INVITATION_URL=

# Required: select smtp (including Brevo) or resend.
EMAIL_PROVIDER=smtp

# SMTP: local Gmail can use 587; Brevo on Render Free uses
# smtp-relay.brevo.com:2525 with STARTTLS and a verified sender.
SMTP_HOST=
# Optional; defaults to 587, or 465 when SMTP_SECURE=true.
SMTP_PORT=
# Optional; defaults to false. Use true for implicit TLS, normally on port 465.
SMTP_SECURE=
# Optional; defaults to true and requires STARTTLS when SMTP_SECURE=false.
SMTP_REQUIRE_TLS=
# Required only for SMTP; plain sender address, for example no-reply@example.com.
SMTP_FROM=
# Optional SMTP authentication pair; set both or leave both blank.
SMTP_USER=
SMTP_PASSWORD=

# Required only when EMAIL_PROVIDER=resend. Use a verified sender/domain and
# keep the API key in the deployment secret manager, not in source control.
RESEND_API_KEY=
RESEND_FROM=

# Optional: TCP port; defaults to 3000.
PORT=
# Optional number of explicitly trusted reverse-proxy hops; defaults to 0.
TRUST_PROXY_HOPS=
# Optional in-memory upload limit in bytes; defaults to 10485760 (10 MiB), max 104857600.
FILE_MAX_SIZE_BYTES=
# Optional: comma-separated HTTPS origins, no paths or trailing slashes.
# HTTP is accepted only for localhost development.
# Blank disables browser cross-origin access.
CORS_ORIGIN=

# Optional Google OAuth: set all four together, or leave all blank to disable.
# OAuth state and one-time exchange codes require the shared MongoDB replica set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full HTTPS backend callback URL ending in /auth/google/callback.
GOOGLE_CALLBACK_URL=
# Frontend HTTPS origin; HTTP is accepted only on localhost.
FRONT_URI=

# Required for file operations: private S3 bucket and region; blank disables storage.
AWS_BUCKET_NAME=
AWS_REGION=
# Optional credential pair; blank uses the AWS SDK default credential chain (IAM roles).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional session token for temporary credentials; requires the credential pair above.
AWS_SESSION_TOKEN=

# Optional Stripe integration: Test Mode only. false preserves assignment mode.
STRIPE_ENABLED=false
# Required together only when STRIPE_ENABLED=true. Never use live keys/prices.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_BASIC_PRICE_ID=price_REPLACE_ME_BASIC
STRIPE_PREMIUM_PRICE_ID=price_REPLACE_ME_PREMIUM
STRIPE_OVERAGE_PRICE_ID=price_REPLACE_ME_OVERAGE
# Copy the Test/Sandbox meter ID from Stripe (current format: mtr_test_...).
# This placeholder is intentionally rejected when Stripe is enabled.
STRIPE_OVERAGE_METER_ID=mtr_test_REPLACE_ME
STRIPE_OVERAGE_EVENT_NAME=REPLACE_ME_EVENT_NAME
STRIPE_PORTAL_CONFIGURATION_ID=bpc_REPLACE_ME
STRIPE_CHECKOUT_SUCCESS_URL=https://frontend.example.invalid/payments/success
STRIPE_CHECKOUT_CANCEL_URL=https://frontend.example.invalid/payments/cancel
STRIPE_PORTAL_RETURN_URL=https://frontend.example.invalid/settings/billing
# Durable Mongo-backed reconciliation poll interval; 10000–300000 milliseconds.
STRIPE_SYNC_INTERVAL_MS=30000

# Optional OpenRouter-backed AI assistant. Disabled unless explicitly enabled.
OPENROUTER_ENABLED=false
# Backend-only OpenRouter key. Leave blank while disabled; never expose to clients.
OPENROUTER_API_KEY=
# Server-selected tool-capable OpenRouter model ID, for example provider/model.
OPENROUTER_MODEL=
# Optional comma-separated ordered fallback model IDs; maximum 3, all tool-capable.
OPENROUTER_FALLBACK_MODELS=
# Provider request timeout in milliseconds; defaults to 30000 (5000–120000).
OPENROUTER_TIMEOUT_MS=30000
# Maximum completion tokens per provider round; defaults to 1000 (64–8192).
OPENROUTER_MAX_OUTPUT_TOKENS=1000
# Maximum sequential read-only tool calls/rounds; defaults to 3 (1–5).
OPENROUTER_MAX_TOOL_ITERATIONS=3
# Optional: require OpenRouter Zero Data Retention-compatible routing.
OPENROUTER_REQUIRE_ZDR=false
# Optional direct Gemini provider. When both are enabled, OpenRouter stays primary.
GEMINI_ENABLED=false
# Backend-only Google AI Studio key; leave blank while disabled.
GEMINI_API_KEY=
# Server-selected tool-capable model; for example gemini-3.5-flash-lite.
GEMINI_MODEL=
# Per-call timeout and output ceiling (independent of OpenRouter).
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=2048
# AI request/storage/context/cost controls with production-safe defaults.
AI_MAX_MESSAGE_CHARS=8000
AI_MAX_HISTORY_MESSAGES=20
AI_MAX_CONTEXT_CHARS=40000
AI_MAX_CONVERSATION_MESSAGES=100
AI_MAX_CONVERSATIONS_PER_USER=100
AI_RATE_LIMIT_PER_MINUTE=10
